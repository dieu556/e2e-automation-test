#
# Headless baresip for a Twilio Elastic SIP Trunk termination test.
# module_path and the stdio line are filled in by docker/entrypoint.sh.
#

sip_listen              0.0.0.0:5060
sip_cafile              /etc/ssl/certs/ca-certificates.crt
sip_transports          udp,tcp,tls
sip_trans_def           tcp

call_local_timeout      120
call_max_calls          1
call_hold_other_calls   no
call_accept             no

audio_player            aubridge,nil
audio_source            ausine,440
audio_level             no
ausrc_format            s16
auplay_format           s16
auenc_format            s16
audec_format            s16
audio_buffer            20-160
audio_telev_pt          101

rtp_tos                 184
rtp_ports               10000-10020
audio_jitter_buffer_type fixed
audio_jitter_buffer_ms  100-200
audio_jitter_buffer_size 50
rtp_stats               no
rtp_timeout             30

module_path             __MODULE_PATH__

__STDIO_LINE__
module_app              ctrl_tcp.so

module                  g711.so
module                  auconv.so
module                  auresamp.so
module                  ausine.so
module                  aubridge.so
module                  uuid.so
module                  stun.so

module_app              account.so
module_app              contact.so
module_app              menu.so

ctrl_tcp_listen         0.0.0.0:4444

ring_aufile             none
ringback_aufile         none
hangup_aufile           none
notfound_aufile         none
busy_aufile             none
error_aufile            none
