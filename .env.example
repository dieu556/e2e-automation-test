# Termination SIP URI, khong kem sip://  (Twilio Console > Elastic SIP Trunking > Termination)
TWILIO_TERMINATION_URI=your-trunk.pstn.twilio.com

# Credential List gan voi trunk. De trong ca hai neu trunk chi dung IP ACL.
# Password: khong dau cach, khong dau ; va khong dau "
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=

# So goi di. Phai la Twilio DID hoac Verified Caller ID, dang E.164
TWILIO_CALLER_ID=+15551234567

# Edge nhan INVITE. Request-URI van la termination URI o tren.
# ashburn | dublin | frankfurt | singapore | sydney | tokyo | sao-paulo | umatilla
TWILIO_OUTBOUND_PROXY=pstn.singapore.twilio.com

# udp | tcp   (tls de sau, khi signaling da thong)
SIP_TRANSPORT=tcp

# So nhan cuoc thu, E.164. Trial chi goi duoc so da verify.
DESTINATION=+84901234567

# Giu may bao lau giay roi tat
CALL_SECONDS=20
